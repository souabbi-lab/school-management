generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum Role {
  ADMIN
  TEACHER
  STUDENT
}

model User {
  id            String         @id @default(cuid())
  name          String
  email         String         @unique
  password      String
  role          Role           @default(STUDENT)
  createdAt     DateTime       @default(now())
  announcements Announcement[]
}

model Teacher {
  id      String  @id @default(cuid())
  name    String
  email   String  @unique
  subject String
  phone   String
  classes Class[]
}

model Class {
  id        String    @id @default(cuid())
  name      String
  grade     String
  teacherId String
  createdAt DateTime  @default(now())
  teacher   Teacher   @relation(fields: [teacherId], references: [id])
  students  Student[]
}

model Student {
  id         String   @id @default(cuid())
  name       String
  email      String   @unique
  phone      String
  enrolledAt DateTime @default(now())
  classId    String?
  class      Class?   @relation(fields: [classId], references: [id])
}

model Announcement {
  id        String   @id @default(cuid())
  title     String
  content   String
  createdAt DateTime @default(now())
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
}
